#!/usr/bin/env sh
# minio-cache — Save and restore CI caches via the CI object store.
#
# (The name is historical: the store behind MINIO_ENDPOINT is SeaweedFS since
# 2026-09-25, and this speaks plain S3 to it through s3.sh, installed next to it
# at /usr/local/lib/keploy-ci/s3.sh — the same client every Keploy repo carries
# as .ci/scripts/s3.sh. MinIO's `mc` is no longer in these images.)
#
# Usage:
#   minio-cache restore <cache-key>   # Stream, verify & unpack if available
#   minio-cache save    <cache-key>   # Pack & upload
#
# Required environment variables:
#   MINIO_ENDPOINT   – e.g. http://192.168.116.165:9001
#   MINIO_ACCESS_KEY – e.g. keploy
#   MINIO_SECRET_KEY – (from secret)
#   CACHE_BUCKET     – defaults to $BUCKET or "woodpecker"; must already exist
#   CACHE_PATHS      – colon-separated list of directories to cache
#                       e.g. "/root/.npm:/root/go/pkg/mod"
#
# The <cache-key> argument is used as the object name inside the bucket's
# "caches/" prefix (expired server-side after 30 days).  Typical keys:
#   npm-<hash>      – node_modules / npm cache
#   gomod-<hash>    – Go module cache
#
# Examples:
#   # Restore npm cache before `npm ci`
#   export CACHE_PATHS="/root/.npm"
#   minio-cache restore "npm-${REPO_NAME}"
#
#   # After build, save it back
#   minio-cache save "npm-${REPO_NAME}"
#
# What each side guarantees:
#   restore  Streamed, as the old `mc cat | tar -x` was, so the archive never
#            lands on disk, but through `s3.sh cat`: every byte range is checked
#            before tar sees it, and the last one only once the whole object's
#            MD5 matches, so a corrupt or cut stream never unpacks as a whole
#            cache. It is all or nothing: if the stream or tar fails partway,
#            every CACHE_PATHS directory is removed again (an absent cache is a
#            cold start; half of one is a broken build). A miss is a cold start
#            (exit 0). A store that cannot deliver the object is reported
#            loudly on stderr and is also a cold start (exit 0), as it always
#            was for this helper: callers in several repos run it without
#            `|| true`. A failed extract of a verified stream (e.g. a full disk)
#            still exits non-zero, as the old `mc cat | tar -x` did. The whole
#            restore is capped at S3_OP_TIMEOUT (600 s): a store that is slow
#            but alive means a cold start, not a stalled lane.
#   save     The archive is written to a temp file and uploaded as ONE object
#            (Content-MD5 on every request, read back; over 5 GiB a verified
#            multipart upload): the object is replaced whole or not at all. A
#            failed upload exits non-zero (as a failed `mc pipe` did; the old
#            `tar | mc pipe` could also publish a truncated archive when tar
#            died mid-stream, which this cannot).
#   disk     restore needs no scratch space beyond s3.sh's in-flight ranges
#            (128 MiB); save needs the compressed archive's size free in
#            ${TMPDIR:-/tmp}.
#   buckets  Never created here (no `mc mb`): a new bucket on the store gets no
#            retention. Lifecycle rules are locked on the store (retention is
#            server-side); CI never writes one.
#
set -eu

ACTION="${1:-}"
CACHE_KEY="${2:-}"
BUCKET="${CACHE_BUCKET:-${BUCKET:-woodpecker}}"
PREFIX="caches"

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "[minio-cache] $*"; }

[ -n "$ACTION" ] && [ -n "$CACHE_KEY" ] || die "Usage: minio-cache <restore|save> <cache-key>"

# Validate env
for v in MINIO_ENDPOINT MINIO_ACCESS_KEY MINIO_SECRET_KEY; do
  eval "val=\${$v:-}"
  [ -n "$val" ] || die "Environment variable $v is required"
done

[ -n "${CACHE_PATHS:-}" ] || die "CACHE_PATHS must be set (colon-separated directories)"

# The image's hash-checked copy; else the one beside this script (a checkout
# of this repo, e.g. docker-build.yml's tests). CDPATH='' and -P keep `cd` from
# printing a directory into the path.
S3=/usr/local/lib/keploy-ci/s3.sh
[ -r "$S3" ] || S3="$(CDPATH='' cd -P -- "$(dirname -- "$0")" && pwd)/s3.sh"
[ -r "$S3" ] || die "s3.sh not found at /usr/local/lib/keploy-ci/s3.sh or next to $0"

OBJECT="${BUCKET}/${PREFIX}/${CACHE_KEY}.tar.zst"
TMP=
cleanup() { [ -z "$TMP" ] || rm -f "$TMP" "$TMP.tar"; }
# Remove every cache directory again (read-only module-cache dirs included).
wipe() {
  OLDIFS="$IFS"; IFS=":"
  # shellcheck disable=SC2086 # split CACHE_PATHS on ':' on purpose
  set -- $CACHE_PATHS
  IFS="$OLDIFS"
  for d in "$@"; do
    [ -e "$d" ] || continue
    chmod -R u+w "$d" 2>/dev/null || true
    rm -rf "$d"
  done
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

case "$ACTION" in
  restore)
    # s3.sh's exit code comes back through a file: a POSIX pipeline reports
    # only tar's.
    TMP=$(mktemp "${TMPDIR:-/tmp}/minio-cache.XXXXXXXX")
    info "Restoring cache: $CACHE_KEY"
    trc=0
    { rc=0; S3_OP_TIMEOUT="${S3_OP_TIMEOUT:-600}" sh "$S3" cat "$OBJECT" || rc=$?; echo "$rc" > "$TMP"; } \
      | tar --zstd -xf - -C / 2>"$TMP.tar" || trc=$?
    rc=$(cat "$TMP")
    case "$rc" in
      0)
        if [ "$trc" -ne 0 ]; then
          sed 's/^/[minio-cache]   tar: /' "$TMP.tar" >&2
          wipe
          die "unpacking $CACHE_KEY failed (tar exit $trc) after a verified download; removed the partial restore"
        fi
        info "Cache restored successfully (streamed, verified)"
        ;;
      3)
        info "No cache found for key: $CACHE_KEY (cold start)"
        ;;
      *)
        wipe
        echo "WARNING: [minio-cache] the object store could not deliver $OBJECT whole (s3.sh exit $rc, above); removed whatever had been unpacked, continuing without the cache (cold start)" >&2
        ;;
    esac
    ;;

  save)
    # Convert colon-separated paths to space-separated, skip missing dirs
    DIRS=""
    # shellcheck disable=SC2086 # split CACHE_PATHS on ':' on purpose
    OLDIFS="$IFS"; IFS=":"; set -- $CACHE_PATHS; IFS="$OLDIFS"
    for d in "$@"; do
      [ -d "$d" ] && DIRS="$DIRS $d"
    done

    if [ -z "$DIRS" ]; then
      info "Nothing to cache (no directories exist)"
      exit 0
    fi

    info "Saving cache: $CACHE_KEY (paths:$DIRS)"
    TMP=$(mktemp "${TMPDIR:-/tmp}/minio-cache.XXXXXXXX")
    # shellcheck disable=SC2086 # DIRS is a space-separated list of existing dirs
    tar --zstd -cf "$TMP" $DIRS
    rc=0
    sh "$S3" put "$TMP" "$OBJECT" || rc=$?
    [ "$rc" -eq 0 ] || die "cache upload of $OBJECT failed (s3.sh exit $rc, above)"
    info "Cache saved successfully"
    ;;

  *)
    die "Unknown action: $ACTION (use 'restore' or 'save')"
    ;;
esac
