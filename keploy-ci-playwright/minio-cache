#!/usr/bin/env sh
# minio-cache — Save and restore CI caches via the CI object store.
#
# (The name is historical: the store behind MINIO_ENDPOINT is SeaweedFS since
# 2026-09-25, and this speaks plain S3 to it through s3.sh, installed next to it
# at /usr/local/lib/keploy-ci/s3.sh — the same client every Keploy repo carries
# as .ci/scripts/s3.sh. MinIO's `mc` is no longer in these images.)
#
# Usage:
#   minio-cache restore <cache-key>   # Download, verify & unpack if available
#   minio-cache save    <cache-key>   # Pack & upload
#
# Required environment variables:
#   MINIO_ENDPOINT   – e.g. http://192.168.116.165:9001
#   MINIO_ACCESS_KEY – e.g. keploy
#   MINIO_SECRET_KEY – (from secret)
#   CACHE_BUCKET     – defaults to $BUCKET or "woodpecker"; must already exist
#   CACHE_PATHS      – colon-separated list of directories to cache
#                       e.g. "/root/.npm:/root/go/pkg/mod"
#
# The <cache-key> argument is used as the object name inside the bucket's
# "caches/" prefix (expired server-side after 30 days).  Typical keys:
#   npm-<hash>      – node_modules / npm cache
#   gomod-<hash>    – Go module cache
#
# Examples:
#   # Restore npm cache before `npm ci`
#   export CACHE_PATHS="/root/.npm"
#   minio-cache restore "npm-${REPO_NAME}"
#
#   # After build, save it back
#   minio-cache save "npm-${REPO_NAME}"
#
# What each side guarantees:
#   restore  The object is downloaded to a temp file and verified (size, and MD5
#            where its ETag is one) BEFORE tar sees a byte, so a connection cut
#            mid-object can no longer leave a half-extracted cache behind (the old
#            `mc cat | tar -x` could). A miss is a cold start (exit 0). A store
#            that cannot answer is reported loudly on stderr and is also a cold
#            start (exit 0), as it always was for this helper: callers in several
#            repos run it without `|| true`. A failed extract (e.g. a full disk)
#            still exits non-zero, as the old `mc cat | tar -x` did.
#   save     The archive is written to a temp file and uploaded with ONE PUT
#            (Content-MD5, read back): the object is replaced whole or not at
#            all. A failed upload exits non-zero (as a failed `mc pipe` did; the
#            old `tar | mc pipe` could also publish a truncated archive when tar
#            died mid-stream, which this cannot). An archive over 5 GiB (S3's
#            single-PUT limit; s3.sh's S3_MAX_PUT_BYTES) is not uploaded: that
#            is reported on stderr and the save exits 0 -- the cache is skipped
#            (any object already under the key stays as it was), the lane is
#            not failed.
#   disk     Both sides need the compressed archive's size free in
#            ${TMPDIR:-/tmp} (restore: beside the tree it expands into). That
#            is the price of verifying before extracting; the old streams used
#            no scratch space.
#   buckets  Never created here (no `mc mb`): a new bucket on the store gets no
#            retention. Lifecycle rules are locked on the store (retention is
#            server-side); CI never writes one.
#
set -eu

ACTION="${1:-}"
CACHE_KEY="${2:-}"
BUCKET="${CACHE_BUCKET:-${BUCKET:-woodpecker}}"
PREFIX="caches"

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "[minio-cache] $*"; }

[ -n "$ACTION" ] && [ -n "$CACHE_KEY" ] || die "Usage: minio-cache <restore|save> <cache-key>"

# Validate env
for v in MINIO_ENDPOINT MINIO_ACCESS_KEY MINIO_SECRET_KEY; do
  eval "val=\${$v:-}"
  [ -n "$val" ] || die "Environment variable $v is required"
done

[ -n "${CACHE_PATHS:-}" ] || die "CACHE_PATHS must be set (colon-separated directories)"

# The image's hash-checked copy; else the one beside this script (a checkout
# of this repo, e.g. docker-build.yml's tests). CDPATH='' and -P keep `cd` from
# printing a directory into the path.
S3=/usr/local/lib/keploy-ci/s3.sh
[ -r "$S3" ] || S3="$(CDPATH='' cd -P -- "$(dirname -- "$0")" && pwd)/s3.sh"
[ -r "$S3" ] || die "s3.sh not found at /usr/local/lib/keploy-ci/s3.sh or next to $0"

OBJECT="${BUCKET}/${PREFIX}/${CACHE_KEY}.tar.zst"
TMP=
cleanup() { [ -z "$TMP" ] || rm -f "$TMP"; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

case "$ACTION" in
  restore)
    TMP=$(mktemp "${TMPDIR:-/tmp}/minio-cache.XXXXXXXX")
    rc=0
    sh "$S3" get "$OBJECT" "$TMP" || rc=$?
    case "$rc" in
      0)
        info "Restoring cache: $CACHE_KEY"
        tar --zstd -xf "$TMP" -C /
        info "Cache restored successfully"
        ;;
      3)
        info "No cache found for key: $CACHE_KEY (cold start)"
        ;;
      *)
        echo "WARNING: [minio-cache] the object store could not serve $OBJECT (s3.sh exit $rc, above); continuing without the cache (cold start)" >&2
        ;;
    esac
    ;;

  save)
    # Convert colon-separated paths to space-separated, skip missing dirs
    DIRS=""
    # shellcheck disable=SC2086 # split CACHE_PATHS on ':' on purpose
    OLDIFS="$IFS"; IFS=":"; set -- $CACHE_PATHS; IFS="$OLDIFS"
    for d in "$@"; do
      [ -d "$d" ] && DIRS="$DIRS $d"
    done

    if [ -z "$DIRS" ]; then
      info "Nothing to cache (no directories exist)"
      exit 0
    fi

    info "Saving cache: $CACHE_KEY (paths:$DIRS)"
    TMP=$(mktemp "${TMPDIR:-/tmp}/minio-cache.XXXXXXXX")
    # shellcheck disable=SC2086 # DIRS is a space-separated list of existing dirs
    tar --zstd -cf "$TMP" $DIRS
    size=$(wc -c < "$TMP" | tr -d ' ')
    limit=${S3_MAX_PUT_BYTES:-5368709120}
    if [ "$size" -gt "$limit" ]; then
      echo "WARNING: [minio-cache] $CACHE_KEY is $size bytes, over the $limit-byte single-PUT limit (S3_MAX_PUT_BYTES); NOT saved -- any object already under this key is left as it was. Narrow CACHE_PATHS." >&2
      exit 0
    fi
    rc=0
    sh "$S3" put "$TMP" "$OBJECT" || rc=$?
    [ "$rc" -eq 0 ] || die "cache upload of $OBJECT failed (s3.sh exit $rc, above)"
    info "Cache saved successfully"
    ;;

  *)
    die "Unknown action: $ACTION (use 'restore' or 'save')"
    ;;
esac
