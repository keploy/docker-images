@@ -58,9 +59,13 @@ type client struct {
 	logs   chan *proto.LogEntry
 	// connectionRetryTimeout bounds how long an RPC keeps failing before it
 	// gives up. Zero means infinite. The clock starts at the first failure, not
-	// when the RPC was issued (see failureWindowBackOff). Whether a give-up
-	// ends the agent is decided by the callers (cmd/agent/core/agent.go).
+	// when the RPC was issued, and starts over when the agent reconnects (see
+	// failureWindowBackOff). Whether a give-up ends the agent is decided by the
+	// callers (cmd/agent/core/agent.go).
 	connectionRetryTimeout time.Duration
+	// ready counts the connection's reconnections for the retry policy. Nil in
+	// a client made without NewGrpcClient.
+	ready *readyTracker
 	// logEntryBufferSize sets the buffer size before the log reader is blocking.
 	// If you have enough memory and log bursts, set it higher.
 	logEntryBufferSize int
@@ -78,8 +83,10 @@ func NewGrpcClient(ctx context.Context, conn *grpc.ClientConn, opts ...ClientOpt
 	}
 
 	client.logs = make(chan *proto.LogEntry, client.logEntryBufferSize) // max memory use: buffer count * 1 MiB
+	client.ready = &readyTracker{conn: conn}
 
 	go client.processLogs(ctx)
+	go client.ready.watch(ctx)
 	return client
 }
 
@@ -112,9 +119,68 @@ func (c *client) IsConnected() bool {
 	return state == connectivity.Ready || state == connectivity.Idle
 }
 
+// connState is the part of *grpc.ClientConn that readyTracker reads.
+type connState interface {
+	GetState() connectivity.State
+	WaitForStateChange(ctx context.Context, sourceState connectivity.State) bool
+}
+
+// readyTracker counts the times the connection has become Ready. If the count
+// moved between two failed attempts, the agent reconnected to the server in
+// between: gRPC reports Ready only once a new transport has completed its
+// handshake with the server.
+type readyTracker struct {
+	conn  connState
+	mu    sync.Mutex
+	last  connectivity.State
+	count uint64
+}
+
+// observe reads the connection's state and counts it if it is a Ready that the
+// previous read did not see. The state is read under the lock, so the reads of
+// the watcher and of failing RPCs are counted in the order they were made: a
+// Ready that a failure saw is not counted again when the watcher sees it late.
+func (r *readyTracker) observe() (uint64, connectivity.State) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	state := r.conn.GetState()
+	if state == connectivity.Ready && r.last != connectivity.Ready {
+		r.count++
+	}
+	r.last = state
+	return r.count, state
+}
+
+// watch reads the state after every change until ctx ends or the connection is
+// closed, so it counts a reconnection while a long poll is open, when no RPC
+// fails to read it.
+func (r *readyTracker) watch(ctx context.Context) {
+	for {
+		_, state := r.observe()
+		if state == connectivity.Shutdown {
+			return
+		}
+		if !r.conn.WaitForStateChange(ctx, state) {
+			return
+		}
+	}
+}
+
+// readyCount reads the connection's state and returns its Ready count, or 0
+// for a client with no connection to watch.
+func (c *client) readyCount() uint64 {
+	if c.ready == nil {
+		return 0
+	}
+	count, _ := c.ready.observe()
+	return count
+}
+
 // failureWindowBackOff wraps the exponential policy and stops it once the
 // operation has been failing for longer than window, counted from the first
-// failure of the current streak.
+// failure of the current streak. A streak ends when the agent reconnects to
+// the server (see readyCountAtFailure).
 //
 // The library's backoff.WithMaxElapsedTime cannot express this: it counts from
 // the moment backoff.Retry was called, but Next and Wait are long polls that
@@ -127,6 +193,8 @@ type failureWindowBackOff struct {
 	window       time.Duration
 	now          func() time.Time
 	firstFailure time.Time
+	// readyCount is the connection's Ready count at the last failed attempt.
+	readyCount uint64
 }
 
 // newFailureWindowBackOff keeps the original tuning of the exponential policy
@@ -153,6 +221,18 @@ func (b *failureWindowBackOff) attemptFailed(started time.Time) {
 	}
 }
 
+// readyCountAtFailure takes the connection's Ready count at a failed attempt.
+// If it moved since the previous failure, the agent reconnected in between, so
+// this failure begins a new outage and the window starts over from it. The
+// interval keeps growing: a server that accepts connections and drops them at
+// once is called at the policy's growing interval, not every 10 ms.
+func (b *failureWindowBackOff) readyCountAtFailure(count uint64) {
+	if count != b.readyCount {
+		b.firstFailure = time.Time{}
+	}
+	b.readyCount = count
+}
+
 // NextBackOff returns backoff.Stop once the window has elapsed since the first
 // failure of the current streak. A zero window never stops.
 func (b *failureWindowBackOff) NextBackOff() time.Duration {
@@ -203,8 +283,9 @@ func (c *client) retryOpts(op string, b backoff.BackOff) []backoff.RetryOption {
 
 // retryRPC is the workhorse used by every RPC method in this file. It runs op
 // under backoff.Retry with the standard options, tells the retry policy how
-// long each failed attempt lived, and translates the few special outcomes the
-// callers care about:
+// long each failed attempt lived and whether the agent reconnected since the
+// previous failure, and translates the few special outcomes the callers care
+// about:
 //
 //   - op succeeds                       -> (result, nil)
 //   - ctx canceled                      -> (zero, nil)            same contract as before
@@ -223,6 +304,7 @@ func retryRPC[T any](ctx context.Context, c *client, opName string, op backoff.O
 		started := b.now()
 		res, err := op()
 		if err != nil {
+			b.readyCountAtFailure(c.readyCount())
 			b.attemptFailed(started)
 		}
 		return res, err
