@@ -513,3 +519,330 @@ func TestFailureWindowBackOffLongAttemptResetsTheInterval(t *testing.T) {
 	b.attemptFailed(started)
 	assert.Equal(t, 10*time.Millisecond, b.NextBackOff())
 }
+
+// fakeConn is a connection whose state the test sets. Its channels belong to
+// the synctest bubble that made it, so a watcher waiting on it is durably
+// blocked.
+type fakeConn struct {
+	mu      sync.Mutex
+	state   connectivity.State
+	changed chan struct{}
+	// returnedFalse is set once WaitForStateChange has returned false, and
+	// waitedAfterFalse if it was called again after that.
+	returnedFalse    atomic.Bool
+	waitedAfterFalse atomic.Bool
+}
+
+// newFakeConn returns a connection that is Ready.
+func newFakeConn() *fakeConn {
+	return &fakeConn{state: connectivity.Ready, changed: make(chan struct{})}
+}
+
+func (f *fakeConn) set(state connectivity.State) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if state == f.state {
+		return
+	}
+	f.state = state
+	close(f.changed)
+	f.changed = make(chan struct{})
+}
+
+func (f *fakeConn) GetState() connectivity.State {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.state
+}
+
+func (f *fakeConn) WaitForStateChange(ctx context.Context, source connectivity.State) bool {
+	if f.returnedFalse.Load() {
+		// The caller ignored the false it got: record that, and end the
+		// caller's goroutine instead of letting it spin.
+		f.waitedAfterFalse.Store(true)
+		runtime.Goexit()
+	}
+
+	f.mu.Lock()
+	state, changed := f.state, f.changed
+	f.mu.Unlock()
+	if state != source {
+		return true
+	}
+	select {
+	case <-ctx.Done():
+		f.returnedFalse.Store(true)
+		return false
+	case <-changed:
+		return true
+	}
+}
+
+// newWatchedClient returns a client whose Ready count follows conn, watched
+// the way NewGrpcClient watches the real connection.
+func newWatchedClient(ctx context.Context, window time.Duration, conn *fakeConn) *client {
+	c := &client{connectionRetryTimeout: window, ready: &readyTracker{conn: conn}}
+	go c.ready.watch(ctx)
+	return c
+}
+
+// The server restarts: it is down for 60 s, comes back, and the re-sent
+// Wait() runs for 90 s on the new connection before that drops too. The second
+// drop begins a new outage, so it is retried, though the first failure is
+// only 150 s, less than two windows, behind it.
+func TestRetryRPCDropAfterAReconnectStartsANewWindow(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancelCause(t.Context())
+		defer cancel(nil)
+		conn := newFakeConn()
+		c := newWatchedClient(ctx, 2*time.Minute, conn)
+		var down time.Time
+		phase := 0
+
+		_, err := retryRPC(ctx, c, "wait", func() (bool, error) {
+			switch phase {
+			case 0: // the long poll; then the server goes away
+				time.Sleep(30 * time.Minute)
+				conn.set(connectivity.Idle)
+				down = time.Now()
+				phase = 1
+				return false, classifyRPCErr(ctx, errGoawayDrop)
+			case 1:
+				if time.Since(down) < time.Minute {
+					conn.set(connectivity.TransientFailure)
+					return false, errNotConnected
+				}
+				// The server is back: the agent reconnects, and the Wait() it
+				// sends again runs for 90 s before this connection drops too.
+				conn.set(connectivity.Ready)
+				time.Sleep(90 * time.Second)
+				conn.set(connectivity.Idle)
+				phase = 2
+				return false, classifyRPCErr(ctx, errGoawayDrop)
+			default:
+				phase = 3
+				return false, nil
+			}
+		})
+
+		require.NoError(t, err)
+		assert.Equal(t, 3, phase)
+	})
+}
+
+// The storm a server sends when it GOAWAYs agents for too many pings: drops
+// after connections that worked for 30 s, 60 s and 110 s, each shorter than the
+// 2 minute window and each reconnecting at once. Every drop is retried.
+func TestRetryRPCDropsAfterReconnectsAreAllRetried(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancelCause(t.Context())
+		defer cancel(nil)
+		conn := newFakeConn()
+		c := newWatchedClient(ctx, 2*time.Minute, conn)
+		lives := []time.Duration{30 * time.Minute, 30 * time.Second, time.Minute, 110 * time.Second}
+		var calls int
+
+		_, err := retryRPC(ctx, c, "wait", func() (bool, error) {
+			calls++
+			if calls > len(lives) {
+				return false, nil
+			}
+			conn.set(connectivity.Ready)
+			time.Sleep(lives[calls-1])
+			conn.set(connectivity.Idle)
+			return false, classifyRPCErr(ctx, errGoawayDrop)
+		})
+
+		require.NoError(t, err)
+		assert.Equal(t, len(lives)+1, calls)
+	})
+}
+
+// With no reconnection the window keeps counting from the first failure, even
+// when an attempt in between took 50 s to fail (a connection attempt that
+// hung). The agent gives up within the window.
+func TestRetryRPCSlowFailureWithoutAReconnectKeepsTheWindow(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancelCause(t.Context())
+		defer cancel(nil)
+		conn := newFakeConn()
+		c := newWatchedClient(ctx, 2*time.Minute, conn)
+		var down time.Time
+		var calls int
+
+		_, err := retryRPC(ctx, c, "wait", func() (bool, error) {
+			calls++
+			switch {
+			case calls == 1:
+				time.Sleep(30 * time.Minute)
+				conn.set(connectivity.Idle)
+				down = time.Now()
+				return false, classifyRPCErr(ctx, errGoawayDrop)
+			case time.Since(down) > 10*time.Minute:
+				return false, backoff.Permanent(errStillRetrying)
+			case calls == 5:
+				conn.set(connectivity.Connecting)
+				time.Sleep(50 * time.Second)
+			}
+			conn.set(connectivity.TransientFailure)
+			return false, errNotConnected
+		})
+
+		require.ErrorIs(t, err, ErrConnectionLost)
+		assert.LessOrEqual(t, time.Since(down), 2*time.Minute)
+	})
+}
+
+// A failure counts the Ready it reads itself. A watcher that gets to that same
+// connection only after the failure does not make it look like a
+// reconnection: the server answers every attempt with an error on a connection
+// that stays Ready, the watcher reads it 100 s into the streak, and the agent
+// still gives up within the window.
+func TestRetryRPCLateWatcherDoesNotStartANewWindow(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := t.Context()
+		conn := newFakeConn()
+		c := &client{connectionRetryTimeout: 2 * time.Minute, ready: &readyTracker{conn: conn}}
+		var first time.Time
+		var calls int
+		watched := false
+
+		_, err := retryRPC(ctx, c, "wait", func() (bool, error) {
+			calls++
+			switch {
+			case calls == 1:
+				first = time.Now()
+			case time.Since(first) > 10*time.Minute:
+				return false, backoff.Permanent(errStillRetrying)
+			case !watched && time.Since(first) > 100*time.Second:
+				watched = true
+				c.ready.observe() // the watcher, late
+			}
+			return false, classifyRPCErr(ctx, status.Error(codes.Unavailable, "server is shutting down"))
+		})
+
+		require.ErrorIs(t, err, backoff.ErrMaxElapsedTime)
+		require.True(t, watched, "gave up before the watcher read the connection")
+		assert.LessOrEqual(t, time.Since(first), 2*time.Minute)
+	})
+}
+
+// A reconnection starts the window over but not the interval, so a server that
+// accepts connections and drops them at once is called at a growing interval,
+// not every 10 ms.
+func TestFailureWindowBackOffReconnectKeepsTheInterval(t *testing.T) {
+	t.Parallel()
+
+	clock := &fakeClock{t: time.Unix(1_700_000_000, 0)}
+	b := &failureWindowBackOff{BackOff: newSteadyExponential(), window: time.Minute, now: clock.now}
+	var next time.Duration
+	for count := range uint64(6) {
+		b.readyCountAtFailure(count + 1) // reconnected before every failure
+		b.attemptFailed(clock.now())
+		next = b.NextBackOff()
+		clock.advance(next)
+	}
+
+	// 10 ms * 1.5^5
+	assert.Equal(t, 75937500*time.Nanosecond, next)
+}
+
+// The watcher ends when the connection is closed, without waiting for its
+// context.
+func TestReadyTrackerWatchEndsWhenTheConnectionCloses(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancelCause(t.Context())
+		defer cancel(nil)
+		conn := newFakeConn()
+		r := &readyTracker{conn: conn}
+		done := make(chan struct{})
+		go func() {
+			r.watch(ctx)
+			close(done)
+		}()
+
+		conn.set(connectivity.Shutdown)
+		synctest.Wait()
+
+		select {
+		case <-done:
+		default:
+			t.Fatal("watch still runs after the connection closed")
+		}
+	})
+}
+
+// The watcher ends when its context ends.
+func TestReadyTrackerWatchEndsWithItsContext(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancelCause(t.Context())
+		conn := newFakeConn()
+		r := &readyTracker{conn: conn}
+		done := make(chan struct{})
+		go func() {
+			r.watch(ctx)
+			close(done)
+		}()
+
+		cancel(nil)
+		synctest.Wait()
+
+		assert.False(t, conn.waitedAfterFalse.Load(), "watch waited again after its context ended")
+		select {
+		case <-done:
+		default:
+			t.Fatal("watch still runs after its context ended")
+		}
+	})
+}
+
+// readyCountOf reads r's count without reading the connection's state.
+func readyCountOf(r *readyTracker) uint64 {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.count
+}
+
+// NewGrpcClient counts the real connection's reconnections: once when it
+// first connects, and once more when it connects again after the server went
+// away and came back.
+func TestNewGrpcClientCountsReconnections(t *testing.T) {
+	ctx, cancel := context.WithCancelCause(t.Context())
+	defer cancel(nil)
+
+	var lis atomic.Pointer[bufconn.Listener]
+	serve := func() *grpc.Server {
+		l := bufconn.Listen(1 << 16)
+		lis.Store(l)
+		srv := grpc.NewServer()
+		go func() { _ = srv.Serve(l) }()
+		return srv
+	}
+	srv := serve()
+	conn, err := grpc.NewClient("passthrough:///bufnet",
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) {
+			return lis.Load().DialContext(ctx)
+		}),
+	)
+	require.NoError(t, err)
+	defer conn.Close()
+	c, ok := NewGrpcClient(ctx, conn).(*client)
+	require.True(t, ok)
+
+	// Connect only starts a connection attempt when the connection is idle,
+	// as it is after the server went away, so it is called until the count
+	// moves.
+	reaches := func(want uint64) func() bool {
+		return func() bool {
+			conn.Connect()
+			return readyCountOf(c.ready) == want
+		}
+	}
+	require.Eventually(t, reaches(1), 10*time.Second, time.Millisecond)
+
+	srv.Stop()
+	srv = serve()
+	defer srv.Stop()
+	require.Eventually(t, reaches(2), 10*time.Second, time.Millisecond)
+}
